        type_name: str | None,
        payload: Buffer,
        origin: Buffer | None = None,
        monotonic_nanos: int = 0,
        flags: int = 0,
    ) -> None: ...
    @staticmethod
    def nested(
        envelope_type: int,
        type_name: str | None,
        children: Sequence[PulseEnvelope],
        origin: Buffer | None = None,
        monotonic_nanos: int = 0,
        flags: int = 0,
    ) -> PulseEnvelope: ...
    @staticmethod
    def from_bytes(data: Buffer) -> PulseEnvelope: ...
    def to_bytes(self) -> bytes: ...
    @property
    def id(self) -> bytes: ...
    @property
    def envelope_type(self) -> int: ...
    @property
    def type_name(self) -> str | None: ...
    @property
    def effective_type_name(self) -> str: ...
    @property
    def payload(self) -> bytes: ...
    @property
    def children(self) -> list[PulseEnvelope] | None: ...
    @property
    def origin(self) -> bytes: ...
    @property
    def monotonic_nanos(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    def canonical_size(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class EnvelopeDecodeError(ValueError): ...

def compute_envelope_id(envelope_type: int, type_name: str | None, payload: Buffer) -> bytes: ...

class RecvMeta:
    @property
    def seq(self) -> int: ...
    @property
    def send_ns(self) -> int: ...
    @property
    def peer(self) -> str: ...

class Sender:
    @staticmethod
    def bind(local_addr: str) -> Sender: ...
    def connect(self, dest: str) -> None: ...
    def send(self, send_ns: int, pulse: Pulse, envelope: bytes) -> int: ...
    def send_to(self, send_ns: int, pulse: Pulse, envelope: bytes, dest: str) -> int: ...
    def send_buffer(self, send_ns: int, pulse: Pulse, buf: Buffer) -> int: ...
    def send_buffer_to(self, send_ns: int, pulse: Pulse, buf: Buffer, dest: str) -> int: ...
    def local_addr(self) -> str: ...
    @staticmethod
    def max_envelope() -> int: ...
    def next_seq(self) -> int: ...

class Receiver:
    @staticmethod
    def bind(local_addr: str) -> Receiver: ...
    def set_read_timeout_ms(self, millis: int | None = None) -> None: ...
    def recv(self) -> tuple[Pulse, bytes, RecvMeta]: ...
    def recv_into(self, buf: Buffer) -> tuple[Pulse, int, RecvMeta]: ...
    def local_addr(self) -> str: ...
    @staticmethod
    def max_envelope() -> int: ...

def bind_pair(local_addr: str) -> tuple[Sender, Receiver]: ...

class Channel:
    MAX_PAYLOAD: ClassVar[int]
    @staticmethod
    def create(name: str, capacity: int = 4096, store_slots: int = 256) -> Channel: ...
    @staticmethod
    def open(name: str, timeout_s: float = 10.0) -> Channel: ...
    def send(self, frames: Buffer | Iterable[Buffer], timeout_s: float = 5.0) -> None: ...
    def recv(self, timeout_s: float | None = None) -> list[bytes] | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_args: object) -> bool: ...
    @property
    def name(self) -> str: ...
    @property
    def is_writer(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def capacity(self) -> int: ...
    @property
    def store_slots(self) -> int: ...
    @property
    def pending(self) -> int: ...

class EnvelopeTooLarge(ValueError): ...
class ChannelClosed(EOFError): ...
