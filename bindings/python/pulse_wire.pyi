# Type stubs for the `pulse_wire` native module (src/lib.rs, src/channel.rs).
#
# maturin puts this file in the wheel beside the module, with the py.typed
# marker. tests/test_loopback.py checks it against the built module: each
# public name of either is a name of the other, each member is of the same
# kind (method, static method, property, class constant), each signature has
# the runtime's parameter names, kinds and defaults, and each exception has
# the runtime's base class.

from collections.abc import Iterable, Sequence
from typing import ClassVar, Final

from typing_extensions import Buffer, Self

__version__: Final[str]
PULSE_WIRE_SIZE: Final[int]
MAX_ENVELOPE: Final[int]
ENVELOPE_ID_DOMAIN_TAG: Final[bytes]

class Instruction:
    NULL: ClassVar[int]
    HEARTBEAT: ClassVar[int]
    DATA: ClassVar[int]

class Pulse:
    WIRE_SIZE: ClassVar[int]
    instruction: int
    monotonic_nanos: int
    chain_step: int
    scope: int
    origin_id: bytes
    envelope_ref: bytes
    def __init__(self) -> None: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Pulse: ...
    def as_bytes(self) -> bytes: ...
    @property
    def origin_id_hex(self) -> str: ...
    @property
    def envelope_ref_hex(self) -> str: ...
    @property
    def store_cursor(self) -> int | None: ...
    def has_envelope(self) -> bool: ...
    def envelope_id(self) -> bytes | None: ...
    def set_envelope_id(self, id: Buffer) -> None: ...

class EnvelopeFlags:
    BROADCAST: ClassVar[int]
    ACK_REQUIRED: ClassVar[int]
    PRIORITY: ClassVar[int]
    COMPRESSED: ClassVar[int]

class PulseEnvelope:
    def __init__(
        self,
